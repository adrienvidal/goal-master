// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Character {
  KNIGHT
  PANDA
}

enum Color {
  BLUE
  RED
  GREEN
  PURPLE
  ORANGE
  BLACK
}

enum Landscape {
  CASTLE
  BAMBOO
  MOUNTAINS
  PLAINS
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

/// One of the two players. `id` is the Better Auth user id.
model Player {
  id              String                @id
  user            User                  @relation(fields: [id], references: [id], onDelete: Cascade)
  email           String                @unique
  pseudo          String
  character       Character
  color           Color                 @unique
  landscape       Landscape             @default(CASTLE)
  /// Catégories de notifications coupées (voir src/game/notifications.ts).
  mutedCategories String[]              @default([])
  createdAt       DateTime              @default(now())
  /// Dernier affichage de /arene : présence « X est dans l'Arène » (spec arene v2)
  arenaSeenAt     DateTime?
  /// Dernière forme dont le joueur a vu la scène d'évolution sur / (accusé de lecture ; la forme elle-même se calcule).
  /// null : joueur d'avant la scène fiable, reçoit sa forme actuelle sans scène (cadrage encart-modes-et-evolution).
  seenForm        Int?
  goals           Goal[]
  applications    Application[]
  widgetKeys      WidgetKey[]
  sentNudges      Nudge[]               @relation("sentNudges")
  gotNudges       Nudge[]               @relation("receivedNudges")
  sentChallenges  Challenge[]           @relation("sentChallenges")
  gotChallenges   Challenge[]           @relation("receivedChallenges")
  sentArenas      Arena[]               @relation("sentArenas")
  gotArenas       Arena[]               @relation("receivedArenas")
  arenaActions    ArenaAction[]
  achievements    UnlockedAchievement[]
  pushSubs        PushSubscription[]
  notifications   NotificationLog[]
  givenQuests     Quest[]               @relation("givenQuests")
  receivedQuests  Quest[]               @relation("receivedQuests")
  /// Compagnon affiché à côté du héros (src/game/quests.ts), choisi parmi ceux adoptés.
  companion       String?
}

model Goal {
  id        String     @id @default(cuid())
  playerId  String
  player    Player     @relation(fields: [playerId], references: [id])
  target    Int        @default(100)
  deadline  DateTime
  status    GoalStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  closedAt  DateTime?

  @@index([playerId, status])
}

model Application {
  id          String    @id @default(cuid())
  playerId    String
  player      Player    @relation(fields: [playerId], references: [id])
  company     String
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?
  /// Identifiant de l'offre côté job-finder (encart) : une même offre ne compte qu'une fois.
  externalRef String?
  /// "job-finder" quand la candidature vient de l'encart, vide pour une saisie à la main.
  source      String?

  @@unique([playerId, externalRef])
  @@index([playerId, createdAt])
}

/// Clé qui relie job-finder à un joueur (cadrage encart-job-finder). Hachée ; au plus une active par joueur.
model WidgetKey {
  id         String    @id @default(cuid())
  playerId   String
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  hash       String    @unique
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastUsedAt DateTime?

  @@index([playerId])
}

/// `message` is the index (0-3) of the fixed nudge messages.
model Nudge {
  id          String   @id @default(cuid())
  senderId    String
  sender      Player   @relation("sentNudges", fields: [senderId], references: [id])
  recipientId String
  recipient   Player   @relation("receivedNudges", fields: [recipientId], references: [id])
  message     Int
  sentAt      DateTime @default(now())

  @@index([senderId, sentAt])
}

/// Défi entre les deux joueurs (spec defi) : seuls la demande, la réponse et le gagnant sont stockés.
model Challenge {
  id           String          @id @default(cuid())
  challengerId String
  challenger   Player          @relation("sentChallenges", fields: [challengerId], references: [id])
  opponentId   String
  opponent     Player          @relation("receivedChallenges", fields: [opponentId], references: [id])
  target       Int
  deadline     DateTime
  status       ChallengeStatus @default(PENDING)
  createdAt    DateTime        @default(now())
  acceptedAt   DateTime?
  closedAt     DateTime?
  winnerId     String?
  wonAt        DateTime?

  @@index([createdAt])
}

/// Achievements are never removed once unlocked.
model UnlockedAchievement {
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id])
  code       String
  unlockedAt DateTime @default(now())

  @@id([playerId, code])
}

// ---------- Better Auth ----------
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  player        Player?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

/// Abonnement Web Push d'un appareil, pour recevoir les relances app fermée.
model PushSubscription {
  endpoint  String   @id
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([playerId])
}

/// One row per notification sent: `key` makes each event go out once, `capped` counts toward the daily limit.
model NotificationLog {
  id       String   @id @default(cuid())
  playerId String
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  key      String
  capped   Boolean
  sentAt   DateTime @default(now())
  /// Événement à mettre dans le bilan du jour (null : pas d'e-mail) ; mailedAt : bilan parti.
  event    Json?
  mailedAt DateTime?

  @@unique([playerId, key])
  @@index([playerId, sentAt])
}

enum ArenaStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ArenaKind {
  ATTACK
  PARRY
  THRUST
  WHIRL
  POTION
  END
}

/// Arène : combat au tour par tour (docs/specs/2026-11-17-arene-design.md). Formes et énergie de départ figées à l'acceptation.
model Arena {
  id               String        @id @default(cuid())
  challengerId     String
  challenger       Player        @relation("sentArenas", fields: [challengerId], references: [id])
  opponentId       String
  opponent         Player        @relation("receivedArenas", fields: [opponentId], references: [id])
  status           ArenaStatus   @default(PENDING)
  createdAt        DateTime      @default(now())
  acceptedAt       DateTime?
  deadline         DateTime?
  challengerForm   Int?
  opponentForm     Int?
  challengerEnergy Int?
  opponentEnergy   Int?
  /// Version des règles du combat, figée à la création (voir rulesFor dans src/game/arena.ts).
  rules            Int           @default(3)
  actions          ArenaAction[]

  @@index([createdAt])
}

/// Une action jouée dans l'Arène ; `value` = dégâts ou soin tirés au moment de l'action.
model ArenaAction {
  id        String    @id @default(cuid())
  arenaId   String
  arena     Arena     @relation(fields: [arenaId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id])
  kind      ArenaKind
  value     Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([arenaId, createdAt])
}

enum QuestStatus {
  OPEN
  DONE
  VALIDATED
  CANCELLED
}

/// Quête lancée par un joueur à l'autre (spec quetes). L'XP et la collection se calculent ; seuls l'offre
/// du coffre (tirée à la validation) et le compagnon adopté sont stockés.
model Quest {
  id          String      @id @default(cuid())
  giverId     String
  giver       Player      @relation("givenQuests", fields: [giverId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    Player      @relation("receivedQuests", fields: [receiverId], references: [id], onDelete: Cascade)
  text        String
  link        String?
  status      QuestStatus @default(OPEN)
  offer       String[]    @default([])
  companion   String?
  /// Nom donné au compagnon adopté (16 caractères au plus) ; à défaut, le nom de l'espèce.
  companionName String?
  createdAt   DateTime    @default(now())
  doneAt      DateTime?
  validatedAt DateTime?
  closedAt    DateTime?

  @@index([receiverId, status])
}
