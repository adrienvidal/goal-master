// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Character {
  KNIGHT
  PANDA
}

enum Color {
  BLUE
  RED
  GREEN
  PURPLE
  ORANGE
  BLACK
}

enum Landscape {
  CASTLE
  BAMBOO
  MOUNTAINS
  PLAINS
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

/// One of the two players. `id` is the Better Auth user id.
model Player {
  id              String                @id
  user            User                  @relation(fields: [id], references: [id], onDelete: Cascade)
  email           String                @unique
  pseudo          String
  character       Character
  color           Color                 @unique
  landscape       Landscape             @default(CASTLE)
  /// Catégories de notifications coupées (voir src/game/notifications.ts).
  mutedCategories String[]              @default([])
  createdAt       DateTime              @default(now())
  goals           Goal[]
  applications    Application[]
  sentNudges      Nudge[]               @relation("sentNudges")
  gotNudges       Nudge[]               @relation("receivedNudges")
  sentChallenges  Challenge[]           @relation("sentChallenges")
  gotChallenges   Challenge[]           @relation("receivedChallenges")
  achievements    UnlockedAchievement[]
  pushSubs        PushSubscription[]
  notifications   NotificationLog[]
}

model Goal {
  id        String     @id @default(cuid())
  playerId  String
  player    Player     @relation(fields: [playerId], references: [id])
  target    Int        @default(100)
  deadline  DateTime
  status    GoalStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  closedAt  DateTime?

  @@index([playerId, status])
}

model Application {
  id          String    @id @default(cuid())
  playerId    String
  player      Player    @relation(fields: [playerId], references: [id])
  company     String
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  @@index([playerId, createdAt])
}

/// `message` is the index (0-3) of the fixed nudge messages.
model Nudge {
  id          String   @id @default(cuid())
  senderId    String
  sender      Player   @relation("sentNudges", fields: [senderId], references: [id])
  recipientId String
  recipient   Player   @relation("receivedNudges", fields: [recipientId], references: [id])
  message     Int
  sentAt      DateTime @default(now())

  @@index([senderId, sentAt])
}

/// Défi entre les deux joueurs (spec defi) : seuls la demande, la réponse et le gagnant sont stockés.
model Challenge {
  id           String          @id @default(cuid())
  challengerId String
  challenger   Player          @relation("sentChallenges", fields: [challengerId], references: [id])
  opponentId   String
  opponent     Player          @relation("receivedChallenges", fields: [opponentId], references: [id])
  target       Int
  deadline     DateTime
  status       ChallengeStatus @default(PENDING)
  createdAt    DateTime        @default(now())
  acceptedAt   DateTime?
  closedAt     DateTime?
  winnerId     String?
  wonAt        DateTime?

  @@index([createdAt])
}

/// Achievements are never removed once unlocked.
model UnlockedAchievement {
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id])
  code       String
  unlockedAt DateTime @default(now())

  @@id([playerId, code])
}

// ---------- Better Auth ----------
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  player        Player?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

/// Abonnement Web Push d'un appareil, pour recevoir les relances app fermée.
model PushSubscription {
  endpoint  String   @id
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([playerId])
}

/// One row per notification sent: `key` makes each event go out once, `capped` counts toward the daily limit.
model NotificationLog {
  id       String   @id @default(cuid())
  playerId String
  player   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  key      String
  capped   Boolean
  sentAt   DateTime @default(now())

  @@unique([playerId, key])
  @@index([playerId, sentAt])
}
